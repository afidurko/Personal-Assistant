{
  "name": "illa-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Cam Electron shell for ILLA Builder — packaged with electron-builder@26.16.1",
  "author": "Aaron Fidurko",
  "license": "Apache-2.0",
  "main": "src/main.js",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:dir": "electron-builder --dir",
    "dist:linux": "electron-builder --linux",
    "check:pin": "node scripts/assert-builder-pin.mjs"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "26.16.1"
  },
  "build": {
    "appId": "com.afidurko.illa-desktop",
    "productName": "ILLA Builder",
    "copyright": "Copyright © ILLA Cloud / Aaron Fidurko",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asar": true,
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
