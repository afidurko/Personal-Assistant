#!/usr/bin/env bash
# Cam privacy guard — layer 2 (local, last stop before the public remote).
# Re-scans every commit being pushed, so history rewritten or committed with
# --no-verify still cannot leave the machine carrying personal information.
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

zero="0000000000000000000000000000000000000000"
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${local_sha:-}" ] && continue
  [ "$local_sha" = "$zero" ] && continue  # branch delete

  if [ "$remote_sha" = "$zero" ]; then
    # New branch: compare against the default branch if we know it, else scan the tree.
    base="$(git rev-parse --verify --quiet origin/main || git rev-parse --verify --quiet origin/HEAD || true)"
  else
    base="$remote_sha"
  fi

  if [ -n "${base:-}" ]; then
    echo "pre-push: pii-guard on ${local_ref} (${base:0:8}..${local_sha:0:8})"
    python3 scripts/pii-guard.py --diff "$base" || status=1
  else
    echo "pre-push: pii-guard on full tree for ${local_ref}"
    python3 scripts/pii-guard.py --all || status=1
  fi
done

if [ "$status" -ne 0 ]; then
  echo "pre-push: refused — personal information or secrets in outgoing commits (docs/PRIVACY_SAFEGUARDS.md)" >&2
fi
exit "$status"
