{
  "version": 1,
  "assistant": "Cam",
  "human": "Aaron",
  "purpose": "Canonical inventory of Cam pieces and how they compose one live system",
  "bus": {
    "sense_to_motor": "scripts/connectome-route.py",
    "live_activity": "data/runtime/live-activity.json",
    "activity_events": "data/runtime/activity-events.jsonl",
    "mesh_api": "http://127.0.0.1:8787",
    "home_ui": "http://127.0.0.1:5173",
    "ws": "ws://127.0.0.1:8787/ws"
  },
  "pieces": [
    {
      "id": "piece.connectome",
      "title": "Brodmann connectome",
      "layer": "brain",
      "paths": ["config/connectome/", "scripts/connectome-route.py", "scripts/connectome-check.py", "server/core/connectome-kernel.ts"],
      "check": "python3 scripts/connectome-check.py",
      "slo": { "max_latency_ms": 50, "probe": "in_process_kernel" },
      "feeds": ["piece.home_cortex", "piece.swarm", "piece.tools"]
    },
    {
      "id": "piece.neural_mesh",
      "title": "Neural mesh scanners",
      "layer": "runtime",
      "paths": ["server/core/scan-orchestrator.ts", "server/workspaces/", "shared/"],
      "check": "npm run lint",
      "feeds": ["piece.home_ui", "piece.autonomy"]
    },
    {
      "id": "piece.home_ui",
      "title": "Cam home (React + Vite)",
      "layer": "presence",
      "paths": ["src/App.tsx", "src/components/CamPresence.tsx"],
      "depends_on": ["piece.neural_mesh", "piece.converse"],
      "feeds": ["piece.home_cortex"]
    },
    {
      "id": "piece.home_cortex",
      "title": "Live 3D cortex",
      "layer": "presence",
      "paths": ["src/lib/cortex/", "visualizations/connectome/"],
      "depends_on": ["piece.connectome", "piece.system_bridge"],
      "feeds": []
    },
    {
      "id": "piece.converse",
      "title": "Cam converse (mic/speak turns)",
      "layer": "presence",
      "paths": ["server/core/cam-converse.ts", "companions/web/"],
      "depends_on": ["piece.system_bridge"],
      "feeds": ["piece.autonomy", "piece.home_cortex"]
    },
    {
      "id": "piece.system_bridge",
      "title": "System bridge (turns → connectome + activity)",
      "layer": "glue",
      "paths": ["server/core/system-bridge.ts", "server/core/connectome-kernel.ts", "server/core/motor-executor.ts", "scripts/cam-system.py", "config/system/pieces.json"],
      "depends_on": ["piece.connectome"],
      "slo": { "max_latency_ms": 200, "probe": "onTurn" },
      "feeds": ["piece.home_cortex", "piece.health"]
    },
    {
      "id": "piece.autonomy",
      "title": "Background self-improve spawn",
      "layer": "runtime",
      "paths": ["server/core/cam-autonomy.ts"],
      "depends_on": ["piece.neural_mesh"],
      "feeds": ["piece.home_cortex"]
    },
    {
      "id": "piece.health",
      "title": "System health + improve engine",
      "layer": "ops",
      "paths": ["scripts/system-health-scan.py", "scripts/improve-engine.py"],
      "depends_on": ["piece.connectome"],
      "feeds": ["piece.autonomy", "piece.home_cortex"]
    },
    {
      "id": "piece.swarm",
      "title": "HAAS privilege + boss/worker",
      "layer": "brain",
      "paths": ["config/swarm/", "scripts/swarm-check.py", "server/core/swarm-runtime.ts"],
      "check": "python3 scripts/swarm-check.py",
      "feeds": ["piece.teams", "piece.cline"]
    },
    {
      "id": "piece.teams",
      "title": "Agent teams (AGI / capability / info / tooling)",
      "layer": "brain",
      "paths": ["config/teams/", "docs/CAM_BRAIN.md"],
      "feeds": ["piece.cline", "piece.public_apis", "piece.scholar"]
    },
    {
      "id": "piece.cline",
      "title": "Cline coding effector",
      "layer": "motor",
      "paths": ["integrations/cline", "config/integrations/cline.md", "scripts/run-cline.py"],
      "feeds": []
    },
    {
      "id": "piece.public_apis",
      "title": "Public APIs catalog",
      "layer": "motor",
      "paths": ["integrations/public-apis", "config/integrations/public-apis.json", "scripts/public-apis-search.py"],
      "check": "python3 scripts/public-apis-check.py",
      "feeds": []
    },
    {
      "id": "piece.scholar",
      "title": "Google Scholar",
      "layer": "sense",
      "paths": ["config/integrations/google-scholar.json", "scripts/scholar-search.py"],
      "feeds": ["piece.teams"]
    },
    {
      "id": "piece.vault",
      "title": "Smart second brain vault",
      "layer": "memory",
      "paths": ["vault/", "integrations/smart-second-brain", "config/persona/vault.json"],
      "feeds": ["piece.teams"]
    },
    {
      "id": "piece.tools",
      "title": "Tools registry",
      "layer": "motor",
      "paths": ["config/tools/registry.json"],
      "feeds": []
    },
    {
      "id": "piece.workspaces",
      "title": "Workspace registry + chooser",
      "layer": "ops",
      "paths": ["config/workspaces/registry.json", "scripts/choose-workspace.py"],
      "feeds": ["piece.cline"]
    },
    {
      "id": "piece.ios",
      "title": "iOS companion converse",
      "layer": "presence",
      "paths": ["companions/ios/", "config/integrations/ios-companion.md"],
      "depends_on": ["piece.converse"],
      "feeds": []
    },
    {
      "id": "piece.persistence",
      "title": "Persistence bundle",
      "layer": "memory",
      "paths": ["identity/persistence/", "scripts/persist-export.py"],
      "feeds": ["piece.vault"]
    },
    {
      "id": "piece.presence_portrait",
      "title": "Cam identity portrait + Audio2Face",
      "layer": "presence",
      "paths": ["identity/persona/cam-face.jpg", "config/persona/avatar.json", "src/components/CamFace.tsx", "scripts/presence-check.py"],
      "check": "python3 scripts/presence-check.py",
      "depends_on": ["piece.converse"],
      "feeds": ["piece.home_ui"]
    },
    {
      "id": "piece.higgsfield",
      "title": "Higgsfield multi-node GPU training",
      "layer": "motor",
      "paths": ["config/integrations/higgsfield.json", "scripts/higgsfield-run.py", "scripts/higgsfield-check.py"],
      "check": "python3 scripts/higgsfield-check.py",
      "depends_on": ["piece.tools"],
      "feeds": []
    },
    {
      "id": "piece.sentinel",
      "title": "Sentinel permission authority + intent journal (Muse pattern)",
      "layer": "brain",
      "paths": ["config/connectome/sentinel-policy.json", "scripts/cam_sentinel.py", "scripts/cam_journal.py", "scripts/cam-sentinel.py", "scripts/sentinel-check.py", "server/core/sentinel.ts"],
      "check": "python3 scripts/sentinel-check.py",
      "depends_on": ["piece.connectome"],
      "feeds": ["piece.system_bridge", "piece.cline"]
    }
  ],
  "boot_order": [
    "piece.persistence",
    "piece.connectome",
    "piece.sentinel",
    "piece.swarm",
    "piece.teams",
    "piece.tools",
    "piece.workspaces",
    "piece.neural_mesh",
    "piece.system_bridge",
    "piece.converse",
    "piece.presence_portrait",
    "piece.autonomy",
    "piece.home_ui",
    "piece.home_cortex",
    "piece.health"
  ],
  "blockers": [
    "Live FunASR / VoiceStudio weights — open PRs #14/#17 (identity gate + speak motor)",
    "Live MemoryBear API — open PR #12 (HMO uses vault/path recall until then)",
    "Live Pupil eye tracking — open PR #18 (foveated world)",
    "Live nulltickets/nullclaw runtime (synaptic body across boots)",
    "Local sLM/DL model weights (heuristic stubs active on motor.slm / motor.dl)",
    "Embodiment theater — open PRs #19/#20/#21 (cards / Joshinator / Inkbox)"
  ]
}
