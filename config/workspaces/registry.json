        {
          "id": "cline",
          "match_any": [
            "cline sdk",
            "cline cli",
            "integrations/cline",
            "@cline/",
            "cline hub",
            "cline extension"
          ]
        },
        {
          "id": "smart-second-brain",
          "match_any": [
            "smart-second-brain",
            "obsidian plugin",
            "second brain plugin"
          ]
        },
        {
          "id": "jarvis",
