{
  "version": 1,
  "description": "Aaron's active coding workspaces for Cam motor.cline resolution",
  "default_workspace_id": "personal-assistant",
  "cline_data_root": "~/.cline/data/workspaces",
  "rules_source": ".clinerules",
  "chooser": {
    "signals": [
      {
        "id": "personal-assistant",
        "match_any": [
          "connectome",
          "cam ",
          "persona",
          "vault",
          "mesh",
          "nullclaw",
          "nulltickets",
          "personal-assistant",
          "persist"
        ]
      },
      {
        "id": "cline",
        "match_any": [
          "cline sdk",
          "cline cli",
          "integrations/cline",
          "@cline/",
          "cline hub",
          "cline extension"
        ]
      },
      {
        "id": "smart-second-brain",
        "match_any": [
          "smart-second-brain",
          "obsidian plugin",
          "second brain plugin"
        ]
      },
      {
        "id": "jarvis",
        "match_any": ["jarvis plugin", "integrations/jarvis", "jarviscli"]
      },
      {
        "id": "paddledetection",
        "match_any": ["paddledetection", "paddle detection", "integrations/paddledetection"]
      },
      {
        "id": "llmavatartalk",
        "match_any": ["llmavatartalk", "audio2face", "riva", "metahuman"]
      }
    ]
  },
  "workspaces": [
    {
      "id": "personal-assistant",
      "label": "Personal-Assistant (Cam)",
      "path": ".",
      "remote": "github.com/afidurko/Personal-Assistant",
      "default_branch": "main",
      "roles_allowed": ["*"],
      "cline_data_dir": "~/.cline/data/workspaces/personal-assistant",
      "rules": [".clinerules"],
      "install_rules": true,
      "cursor_bootstrap": true,
      "primary": true
    },
    {
      "id": "cline",
      "label": "Cline coding agent",
      "path": "integrations/cline",
      "remote": "github.com/afidurko/cline",
      "default_branch": "main",
      "roles_allowed": ["coding", "docs", "ops", "chief", "qa", "researcher"],
      "cline_data_dir": "~/.cline/data/workspaces/cline",
      "rules": [".clinerules"],
      "install_rules": true,
      "cursor_bootstrap": true,
      "notes": "Prefer standalone clone if submodule is empty"
    },
    {
      "id": "smart-second-brain",
      "label": "Smart Second Brain",
      "path": "integrations/smart-second-brain",
      "remote": "github.com/afidurko/smart-second-brain",
      "default_branch": "main",
      "roles_allowed": ["coding", "memory-curator", "docs", "chief"],
      "cline_data_dir": "~/.cline/data/workspaces/smart-second-brain",
      "rules": [".clinerules"],
      "install_rules": true,
      "cursor_bootstrap": true
    },
    {
      "id": "jarvis",
      "label": "Jarvis CLI utilities",
      "path": "integrations/jarvis",
      "remote": "github.com/afidurko/Jarvis",
      "default_branch": "master",
      "roles_allowed": ["coding", "ops", "chief"],
      "cline_data_dir": "~/.cline/data/workspaces/jarvis",
      "rules": [".clinerules"],
      "install_rules": true,
      "cursor_bootstrap": true
    },
    {
      "id": "paddledetection",
      "label": "PaddleDetection vision",
      "path": "integrations/paddledetection",
      "remote": "github.com/afidurko/PaddleDetection",
      "default_branch": "release/2.9",
      "roles_allowed": ["coding", "vision", "chief"],
      "cline_data_dir": "~/.cline/data/workspaces/paddledetection",
      "rules": [".clinerules"],
      "install_rules": true,
      "cursor_bootstrap": true
    },
    {
      "id": "llmavatartalk",
      "label": "LLMAvatarTalk presence",
      "path": "integrations/llmavatartalk",
      "remote": "github.com/afidurko/LLMAvatarTalk-An-Interactive-AI-Assistant",
      "default_branch": "main",
      "roles_allowed": ["coding", "comms", "chief"],
      "cline_data_dir": "~/.cline/data/workspaces/llmavatartalk",
      "rules": [".clinerules"],
      "install_rules": true,
      "cursor_bootstrap": true
    }
  ]
}
