            "paddledetection",
            "paddle detection",
            "integrations/paddledetection"
          ]
        },
        {
          "id": "llmavatartalk",
          "match_any": [
            "llmavatartalk",
            "audio2face",
            "riva",
            "metahuman"
          ]
        }
      ]
    },
    "runner": "scripts/run-cline.py",
    "mcp": "scripts/cam-mcp-server.py",
    "schedules": "config/workspaces/schedules.json"
