            "cline sdk",
            "cline cli",
            "integrations/cline",
            "@cline/",
            "cline hub",
            "cline extension"
          ]
        },
        {
          "id": "smart-second-brain",
          "match_any": [
            "smart-second-brain",
            "obsidian plugin",
            "second brain plugin"
          ]
        },
        {
          "id": "memorybear",
          "match_any": [
            "memorybear",
            "memory bear",
            "integrations/memorybear",
            "cognitive memory",
            "memory extract",
            "memory forget",
            "/v1/memory"
          ]
        },
        {
          "id": "jarvis",
          "match_any": [
            "jarvis plugin",
            "integrations/jarvis",
            "jarviscli"
          ]
        },
        {
          "id": "paddledetection",
          "match_any": [
            "paddledetection",
            "paddle detection",
            "integrations/paddledetection"
          ]
        },
        {
          "id": "llmavatartalk",
          "match_any": [
            "llmavatartalk",
            "audio2face",
            "riva",
            "metahuman"
          ]
        },
        {
          "id": "public-apis",
          "match_any": [
            "public-apis",
            "public apis",
            "free api catalog",
            "integrations/public-apis",
            "apilayer public-apis"
          ]
        },
