    "rules_source": ".clinerules",
    "chooser": {
      "signals": [
        {
          "id": "personal-assistant",
          "match_any": [
            "connectome",
            "cam ",
            "persona",
            "vault",
            "mesh",
            "nullclaw",
            "nulltickets",
            "personal-assistant",
            "persist"
