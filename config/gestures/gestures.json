    }
  ],
  "grammar": {
    "engagement": {
      "poses": [
        "open_palm",
        "back_of_hand"
      ],
      "dwell_ms": 300,
      "window_ms": 2500,
      "glyph": "hand icon at the top of the screen (Huawei convention) — the next motion inside the window is read as a command",
      "always_on_without_engagement": [
        "converse.attention",
        "converse.stop",
        "presence.hold_all"
      ]
    },
    "one_intent_per_window": true,
    "sequence_timeout_ms": 1500,
    "carry_ttl_ms": 10000,
    "default_confidence_min": 0.7,
    "default_cooldown_ms": 800,
    "tie_break": [
      "learned binding over default",
      "longer match (more steps) over shorter — a fist→palm sequence beats a lone palm push",
      "context-specific over '*'",
      "sequence over dynamic over static",
      "higher priority value",
      "otherwise log_only and ask"
    ],
    "handedness": "Left-hand motions are mirrored so flick/swipe directions are screen-relative, not hand-relative",
    "two_hands": "Both-hand gestures need both hands labeled within 300 ms of each other",
    "unbound": "A recognized gesture with no binding in the active context resolves to system.log_only (mesh/gestures) so it can be taught later",
    "grab_disambiguation": {
      "primitive": "open_palm → closed_fist while engaged (Huawei 'grab')",
      "resolves_by_what_follows": {
        "reopen_in_place_within_800ms": "ui.collapse",
        "hold_still_1200ms_or_more": "ui.screenshot",
        "hold_and_translate_out_or_pull_out": "device.handoff_grab (enters 'carrying')"
      },
      "huawei_note": "On HarmonyOS 5 the same grab triggers Grabshot and Air Transfer together when both switches are on; Cam resolves by the follow-up motion instead of firing both"
    }
  },
  "learning": {
    "principle": "Cam recognizes with the vocabulary below and remembers what Aaron teaches on top of it. Defaults live in git; learned bindings live in data/gestures/learned.json and are distilled to mesh/gestures + MemoryBear.",
    "who_may_teach": [
      "Aaron"
    ],
    "teach_flow": [
      "Aaron says 'Cam, learn this gesture' (or runs cam-gestures.py teach) → context 'teach'",
      "Aaron performs the gesture 3–5 times; only landmark sequences are kept locally (data/gestures/samples/), never frames",
      "Aaron states the meaning and picks an action from actions.json (or 'log only')",
      "Cam replays: 'When you do <gesture> while <context>, I will <action>' → thumb_up confirms, thumb_down discards",
      "Binding is written with provenance {taught_by: Aaron, taught_at, samples, context} and mirrored to mesh/gestures"
    ],
    "precedence": [
      "learned + context",
      "learned + '*'",
      "default + context",
      "default + '*'"
    ],
    "conflict_policy": "Re-binding a gesture that already has a default or learned meaning in the same context requires an explicit replace; otherwise Cam refuses and reports the existing meaning",
    "feedback": "converse.confirm / converse.reject within 5 s after a gesture action is logged as reinforcement; confidence_min adapts per gesture within [0.6, 0.95]; reject rate > 30% over 20 uses flags the gesture for recalibration in gesture-check",
    "forgetting": "Learned bindings unused for 90 days are flagged stale in doctor output; nothing is auto-deleted — only Aaron forgets",
    "custom_model": "Once ≥ 30 samples exist for a custom pose, Model Maker retrains data/gestures/cam-gestures.task offline (switch.cam_enhance gate for shipping the new model)"
  },
