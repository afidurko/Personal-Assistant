    "mediapipe_model_maker": "https://developers.google.com/edge/mediapipe/solutions/customization/gesture_recognizer"
  },
  "recognizer": {
    "primary": "mediapipe_gesture_recognizer",
    "runs_on": "companion_pwa (on-device Safari, WASM) — frames never leave the device; only labels + landmarks-derived motion leave",
    "landmarks_per_hand": 21,
    "max_hands": 2,
    "canned_labels": [
      "None",
      "Closed_Fist",
      "Open_Palm",
      "Pointing_Up",
      "Thumb_Down",
      "Thumb_Up",
      "Victory",
      "ILoveYou"
    ],
    "custom_model": "data/gestures/cam-gestures.task (Model Maker export; folders per label + a none class)",
    "custom_prefers_over_canned": true,
    "engagement_distance_cm": [
      20,
      60
    ],
    "frame_rate_hz": 15,
    "smoothing_window_frames": 5,
    "aaron_repo_slot": "integrations/<gesture-repo> — Aaron's starter repo (link pending); mounted as a submodule and mapped onto these primitives, not the other way round"
  },
