    },
    {
      "id": "chat.imessage",
      "label": "iMessage / SMS",
      "kind": "channel",
      "mode": "via_brain",
      "sense": "sense.chat.aaron",
      "motor": "motor.text",
      "switch": "switch.outbound",
      "scripts": [],
      "config": null,
      "mcp_tools": [],
      "roles": [
        "comms",
        "chief"
