    },
    {
      "id": "chat.slack",
      "label": "Slack / Discord / Telegram / WhatsApp",
      "kind": "channel",
      "mode": "via_brain",
      "sense": "sense.chat.aaron",
      "motor": "motor.text",
      "switch": "switch.outbound",
      "scripts": [],
