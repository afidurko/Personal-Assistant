    },
    {
      "id": "email.thread",
      "label": "Email (nullclaw native inbox)",
      "kind": "channel",
      "mode": "via_brain",
      "sense": "sense.email.thread",
      "motor": "motor.text",
      "switch": "switch.outbound",
      "scripts": [],
      "config": null,
      "mcp_tools": [],
