        "SERPAPI_API_KEY"
      ],
      "scripts": [
        "scripts/scholar-search.py"
      ],
      "config": "config/integrations/google-scholar.json",
      "mcp_tools": [],
      "roles": [
        "researcher",
        "info-retriever",
        "agi-scout"
      ],
      "status": "enabled_needs_credential"
    },
    {
      "id": "memorybear",
      "label": "MemoryBear cognitive memory",
      "kind": "app",
      "mode": "act",
      "sense": "sense.memorybear.hit",
      "motor": "motor.memorybear",
      "switch": "switch.autonomy",
      "credential_env": [
        "MEMORYBEAR_API_KEY",
        "MEMORYBEAR_END_USER_ID"
      ],
      "scripts": [
        "scripts/memorybear.py",
        "scripts/memorybear-check.py"
      ],
      "config": "config/integrations/memorybear.json",
      "mcp_tools": [
        "memorybear_read",
        "memorybear_write"
      ],
      "roles": "all",
      "status": "enabled_needs_credential"
    },
    {
      "id": "jarvis",
      "label": "Jarvis local utilities",
      "kind": "tool",
      "mode": "act",
      "sense": "sense.jarvis.result",
      "motor": "motor.jarvis",
      "switch": "switch.autonomy",
      "scripts": [],
      "config": "config/integrations/jarvis.md",
      "mcp_tools": [],
      "roles": "all",
      "status": "enabled",
      "notes": "Deterministic CLI chores (weather, conversions). Not a second brain."
    },
    {
      "id": "voicestudio",
      "label": "VoiceStudio local TTS / ASR",
      "kind": "app",
      "mode": "act",
      "sense": "sense.voicestudio.result",
      "motor": "motor.voicestudio",
      "switch": "switch.outbound",
      "scripts": [
