      ],
      "config": "config/integrations/voicestudio.json",
      "mcp_tools": [
        "voicestudio_health"
      ],
      "roles": [
        "comms",
        "chief"
      ],
      "status": "enabled",
      "notes": "Speaking as Cam to Aaron; gated like any voice motor."
    },
    {
      "id": "loop-engineering",
      "label": "Loop engineering (L1 report loops)",
      "kind": "internal",
      "mode": "read",
      "sense": "sense.loop.tick",
      "motor": "motor.loop",
      "switch": "switch.autonomy",
      "scripts": [
        "scripts/loop-run.py",
