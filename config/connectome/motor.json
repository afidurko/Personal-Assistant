{
  "version": 1,
  "analogy": "Motor periphery — effectors fire only after switch resolves to act",
  "effectors": [
    {
      "id": "motor.text",
      "channel": ["sms", "imessage", "chat"],
      "requires_switch": ["switch.outbound", "switch.kill"],
      "persona": "Cam fluent English soft airy when speaking as Cam"
    },
    {
      "id": "motor.call",
      "channel": ["phone"],
      "requires_switch": ["switch.outbound", "switch.kill"]
    },
    {
      "id": "motor.facetime",
      "channel": ["facetime"],
      "requires_switch": ["switch.outbound", "switch.kill"]
    },
    {
      "id": "motor.speak",
      "channel": ["riva_tts", "audio2face", "metahuman_optional"],
      "requires_switch": ["switch.presence", "switch.outbound", "switch.kill"],
      "voice_profile": "config/persona/voice.json"
    },
    {
      "id": "motor.jarvis",
      "channel": ["jarvis_cli"],
      "requires_switch": ["switch.autonomy", "switch.kill"]
    },
    {
      "id": "motor.docs",
      "channel": ["filesystem", "docs_editors"],
      "requires_switch": ["switch.autonomy", "switch.kill"]
    },
    {
      "id": "motor.jobs",
      "channel": ["linkedin", "indeed"],
      "requires_switch": ["switch.careers_submit", "switch.kill"]
    },
    {
      "id": "motor.vault",
      "channel": ["obsidian_vault"],
      "path": "vault",
      "requires_switch": ["switch.autonomy", "switch.kill"]
    },
    {
      "id": "motor.calendar",
      "channel": ["calendar"],
      "requires_switch": ["switch.autonomy", "switch.kill"]
    },
    {
      "id": "motor.mesh",
      "channel": ["nulltickets_store"],
      "requires_switch": ["switch.autonomy", "switch.kill"],
      "notes": "Kill pauses new mesh claims; curator may flush logs only if Aaron allows"
    },
    {
      "id": "motor.web_fetch",
      "channel": ["http_fetch", "arxiv_api"],
      "requires_switch": ["switch.research_scan", "switch.kill"],
      "notes": "Fetch papers/findings for AGI scan and info team — no outbound messaging"
    },
    {
      "id": "motor.enhance",
      "channel": ["config_patch", "role_prompt", "connectome_edge", "slm_dl_recipe"],
      "requires_switch": ["switch.cam_enhance", "switch.kill"],
      "notes": "Apply Cam functionality changes only when Aaron flips switch.cam_enhance"
    },
    {
      "id": "motor.slm",
      "channel": ["local_slm"],
      "requires_switch": ["switch.slm_local", "switch.kill"],
      "notes": "Invoke Cam sLM cortex (classify/route/compress/draft assist)"
    },
    {
      "id": "motor.dl",
      "channel": ["local_dl", "embeddings", "rerank"],
      "requires_switch": ["switch.dl_local", "switch.kill"],
      "notes": "Invoke Cam DL cortex (embed/rerank/cluster/identity vectors)"
    }
  ],
  "response_rule": "Motor output must correspond to an active sensory→center→switch act pathway (no orphan actions)"
}
