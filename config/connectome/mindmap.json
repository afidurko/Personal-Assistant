  "ios_companion_stack_picks": {
    "analogy": "Distilled from SwiftGuide 2026 report for Cam's native companion",
    "picks": [
      {
        "niche": "Architecture",
        "prefer": ["swift-composable-architecture", "SwiftUI"],
        "avoid_new": ["RxSwift", "PromiseKit", "ReSwift"]
      },
      {
        "niche": "Local-first persistence",
        "prefer": ["SwiftData", "GRDB.swift", "KeychainAccess"],
        "avoid_new": ["SwiftyUserDefaults", "CoreStore"]
      },
      {
        "niche": "Structured knowledge / Markdown",
        "prefer": ["Down", "Splash", "native AttributedString(markdown:)"],
        "notes": "Same longevity pattern as SwiftGuide ↔ vault maps"
      },
      {
        "niche": "Network to Cam host",
        "prefer": ["URLSession", "Starscream optional for converse WS"],
        "notes": "Tailscale private network; minimal deps"
      },
      {
        "niche": "Engineering",
        "prefer": ["SwiftLint", "swift-snapshot-testing", "Tuist optional"]
      }
    ]
  }
