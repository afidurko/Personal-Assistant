        "sense.vault.hit",
        "center.qa",
        "switch.autonomy",
        "motor.vault"
      ],
      "side_effects": ["motor.mesh"],
      "behavior": "source_backed_briefs"
    },
    {
      "id": "hotspot.docs",
      "center": "center.docs",
      "pathway": [
        "sense.chat.aaron",
        "center.chief",
        "center.router",
        "center.docs",
        "switch.autonomy",
        "motor.docs"
